    %layer1_barrier_empty = tensor.empty() : tensor<256xf32>
    %layer1_barrier = tensor.insert_slice %layer1 into %layer1_barrier_empty[0] [256] [1]
        : tensor<256xf32> into tensor<256xf32>
    %sq1_empty = tensor.empty() : tensor<256xf32>
    %sq1 = linalg.generic {
        indexing_maps = [#map1d, #map1d],
        iterator_types = ["parallel"]}
        ins(%layer1_barrier : tensor<256xf32>)
        outs(%sq1_empty : tensor<256xf32>) {
    ^bb0(%in: f32, %out: f32):
      %mul = arith.mulf %in, %in : f32
      linalg.yield %mul : f32
    } -> tensor<256xf32>

    %layer2_matvec = linalg.matvec
        ins(%w2_fused, %sq1 : tensor<128x256xf32>, tensor<256xf32>)
        outs(%zero2 : tensor<128xf32>) -> tensor<128xf32>
    %layer2_matvec_barrier_empty = tensor.empty() : tensor<128xf32>
    %layer2_matvec_barrier = tensor.insert_slice %layer2_matvec into %layer2_matvec_barrier_empty[0] [128] [1]
        : tensor<128xf32> into tensor<128xf32>
    %layer2_bias_empty = tensor.empty() : tensor<128xf32>
    %layer2 = linalg.generic {
        indexing_maps = [#map1d, #map1d, #map1d],
        iterator_types = ["parallel"]}
        ins(%layer2_matvec_barrier, %b2_fused : tensor<128xf32>, tensor<128xf32>)
        outs(%layer2_bias_empty : tensor<128xf32>) {
    ^bb0(%acc: f32, %bias: f32, %out: f32):
      %sum = arith.addf %acc, %bias : f32
      linalg.yield %sum : f32
    } -> tensor<128xf32>
    %layer2_barrier_empty = tensor.empty() : tensor<128xf32>
    %layer2_barrier = tensor.insert_slice %layer2 into %layer2_barrier_empty[0] [128] [1]
        : tensor<128xf32> into tensor<128xf32>
    %sq2_empty = tensor.empty() : tensor<128xf32>
    %sq2 = linalg.generic {
        indexing_maps = [#map1d, #map1d],
        iterator_types = ["parallel"]}
        ins(%layer2_barrier : tensor<128xf32>)
        outs(%sq2_empty : tensor<128xf32>) {
    ^bb0(%in: f32, %out: f32):
      %mul = arith.mulf %in, %in : f32
      linalg.yield %mul : f32
    } -> tensor<128xf32>

    %layer3_matvec = linalg.matvec
        ins(%w3_fused, %sq2 : tensor<64x128xf32>, tensor<128xf32>)
        outs(%zero3 : tensor<64xf32>) -> tensor<64xf32>
    %layer3_matvec_barrier_empty = tensor.empty() : tensor<64xf32>
    %layer3_matvec_barrier = tensor.insert_slice %layer3_matvec into %layer3_matvec_barrier_empty[0] [64] [1]
        : tensor<64xf32> into tensor<64xf32>
    %layer3_bias_empty = tensor.empty() : tensor<64xf32>
    %layer3 = linalg.generic {
        indexing_maps = [#map1d, #map1d, #map1d],
        iterator_types = ["parallel"]}
        ins(%layer3_matvec_barrier, %b3_fused : tensor<64xf32>, tensor<64xf32>)
        outs(%layer3_bias_empty : tensor<64xf32>) {
    ^bb0(%acc: f32, %bias: f32, %out: f32):
      %sum = arith.addf %acc, %bias : f32
      linalg.yield %sum : f32
    } -> tensor<64xf32>
    %layer3_barrier_empty = tensor.empty() : tensor<64xf32>
    %layer3_barrier = tensor.insert_slice %layer3 into %layer3_barrier_empty[0] [64] [1]
        : tensor<64xf32> into tensor<64xf32>
    %sq3_empty = tensor.empty() : tensor<64xf32>
    %sq3 = linalg.generic {
        indexing_maps = [#map1d, #map1d],
        iterator_types = ["parallel"]}
        ins(%layer3_barrier : tensor<64xf32>)
        outs(%sq3_empty : tensor<64xf32>) {
    ^bb0(%in: f32, %out: f32):
      %mul = arith.mulf %in, %in : f32
      linalg.yield %mul : f32
    } -> tensor<64xf32>

    %logits_matvec = linalg.matvec
        ins(%wf, %sq3 : tensor<10x64xf32>, tensor<64xf32>)
        outs(%zerof : tensor<10xf32>) -> tensor<10xf32>
    %logits_matvec_barrier_empty = tensor.empty() : tensor<10xf32>
    %logits_matvec_barrier = tensor.insert_slice %logits_matvec into %logits_matvec_barrier_empty[0] [10] [1]
        : tensor<10xf32> into tensor<10xf32>
    %logits_empty = tensor.empty() : tensor<10xf32>
    %logits = linalg.generic {
        indexing_maps = [#map1d, #map1d, #map1d],
        iterator_types = ["parallel"]}
        ins(%logits_matvec_barrier, %bf : tensor<10xf32>, tensor<10xf32>)
        outs(%logits_empty : tensor<10xf32>) {
    ^bb0(%acc: f32, %bias: f32, %out: f32):
      %sum = arith.addf %acc, %bias : f32
      linalg.yield %sum : f32
    } -> tensor<10xf32>
    return %logits : tensor<10xf32>
  }
}
