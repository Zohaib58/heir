        outs(%zero_layer3 : tensor<32xf32>) -> tensor<32xf32>
    %layer3_matvec_barrier_empty = tensor.empty() : tensor<32xf32>
    %layer3_matvec_barrier = tensor.insert_slice %layer3_matvec into %layer3_matvec_barrier_empty[0] [32] [1]
        : tensor<32xf32> into tensor<32xf32>
    %layer3_bias_empty = tensor.empty() : tensor<32xf32>
    %layer3 = linalg.generic {
        indexing_maps = [#map1d, #map1d, #map1d],
        iterator_types = ["parallel"]}
        ins(%layer3_matvec_barrier, %b3 : tensor<32xf32>, tensor<32xf32>)
        outs(%layer3_bias_empty : tensor<32xf32>) {
    ^bb0(%acc: f32, %bias: f32, %out: f32):
      %sum = arith.addf %acc, %bias : f32
      linalg.yield %sum : f32
    } -> tensor<32xf32>

    %layer3_barrier_empty = tensor.empty() : tensor<32xf32>
    %layer3_barrier = tensor.insert_slice %layer3 into %layer3_barrier_empty[0] [32] [1]
        : tensor<32xf32> into tensor<32xf32>
    %square_layer3_empty = tensor.empty() : tensor<32xf32>
    %square_layer3 = linalg.generic {
        indexing_maps = [#map1d, #map1d],
        iterator_types = ["parallel"]}
        ins(%layer3_barrier : tensor<32xf32>)
        outs(%square_layer3_empty : tensor<32xf32>) {
    ^bb0(%in: f32, %out: f32):
      %mul = arith.mulf %in, %in : f32
      linalg.yield %mul : f32
    } -> tensor<32xf32>

    %logits_matvec = linalg.matvec
        ins(%w4, %square_layer3 : tensor<10x32xf32>, tensor<32xf32>)
        outs(%zero_logits : tensor<10xf32>) -> tensor<10xf32>
    %logits_matvec_barrier_empty = tensor.empty() : tensor<10xf32>
    %logits_matvec_barrier = tensor.insert_slice %logits_matvec into %logits_matvec_barrier_empty[0] [10] [1]
        : tensor<10xf32> into tensor<10xf32>
    %logits_bias_empty = tensor.empty() : tensor<10xf32>
    %logits = linalg.generic {
        indexing_maps = [#map1d, #map1d, #map1d],
        iterator_types = ["parallel"]}
        ins(%logits_matvec_barrier, %b4 : tensor<10xf32>, tensor<10xf32>)
        outs(%logits_bias_empty : tensor<10xf32>) {
    ^bb0(%acc: f32, %bias: f32, %out: f32):
      %sum = arith.addf %acc, %bias : f32
      linalg.yield %sum : f32
    } -> tensor<10xf32>

    return %logits : tensor<10xf32>
  }
}
